---
import Layout from "../layouts/Layout.astro";
import MapQuiz from "../components/map/MapQuiz";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "The Map — Beyond Diagnosis",
  applicationCategory: "HealthApplication",
  description:
    "A personalized cancer screening and risk timeline, built in your browser from general screening guidelines. Nothing is stored or shared unless you ask.",
  url: new URL("/my-plan", "https://h6s-712e2e2f964157-ninahf9.wix-site-host.com"),
};
---

<Layout
  title="The Map"
  description="Get your personalized cancer screening timeline in about 60 seconds — free, private, and built from general screening guidelines. Nothing is stored unless you ask."
  jsonLd={jsonLd}
  canonicalPath="/my-plan"
>
  <section class="bg-white py-14 sm:py-20">
    <div class="mx-auto max-w-2xl px-5 sm:px-8">
      <MapQuiz client:load />
    </div>
  </section>
</Layout>
