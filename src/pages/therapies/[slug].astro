---
import Layout from "../../layouts/Layout.astro";
import LifeStageDetail from "../../components/LifeStageDetail.astro";
import { getLifeStageEntry, getLifeStageEntries, imgSrc } from "../../lib/content";

export const prerender = false;

const { slug } = Astro.params;
const entry = slug ? await getLifeStageEntry("Therapies", slug) : null;

if (!entry) {
  return new Response(null, { status: 404 });
}

const related = (await getLifeStageEntries("Therapies")).filter((e) => e._id !== entry._id).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: entry.title,
  url: new URL(`/therapies/${entry.slug}`, Astro.site ?? Astro.url.origin),
  disclaimer: "Not medical advice. Always consult your care team.",
};
---

<Layout
  title={entry.title}
  description={entry.intro.slice(0, 155)}
  image={imgSrc(entry.heroImage, 1200, 630) || undefined}
  jsonLd={jsonLd}
  canonicalPath={`/therapies/${entry.slug}`}
>
  <LifeStageDetail
    entry={entry}
    basePath="/therapies"
    backHref="/paths/treatment"
    backLabel="Back to Second Opinion"
    tone="terracotta"
    related={related}
    relatedHeading="More on treatment"
  />
</Layout>
