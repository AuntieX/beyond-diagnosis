---
import Layout from "../layouts/Layout.astro";
import Media from "../components/Media.astro";
import PathCard from "../components/PathCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Reveal from "../components/Reveal.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { getArticles, getWarningSigns, getAccessGuides, distinctCancerTypes } from "../lib/content";
import { buildConfig, fadeUpGroup, fadeUpReveal, heroParallax } from "../lib/motion";
import { HOMEPAGE_HERO_URL } from "../lib/site-images";
import { PATHS } from "../lib/paths";

const [articles, warningSigns, accessGuides] = await Promise.all([
  getArticles(),
  getWarningSigns(),
  getAccessGuides(),
]);
const cancerTypes = distinctCancerTypes(warningSigns);
const latestArticles = articles.slice(0, 3);

const cardKeys = PATHS.map((p) => `path-${p.key}`);
const statKeys = ["stat-signs", "stat-guides", "stat-types"];
const articleKeys = latestArticles.map((_, i) => `home-article-${i}`);

const motion = buildConfig([
  heroParallax("home-hero-image"),
  fadeUpReveal("home-hero-heading", 0),
  fadeUpReveal("home-hero-subhead", 100),
  fadeUpReveal("home-hero-ctas", 180),
  fadeUpReveal("map-how-it-works", 0),
  ...fadeUpGroup(cardKeys),
  ...fadeUpGroup(statKeys),
  ...fadeUpGroup(articleKeys),
]);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Beyond Diagnosis",
  description:
    "Editorial cancer education for people 35 and up: screening schedules, warning signs, and clear guidance grounded in evidence.",
  url: Astro.site ?? Astro.url.origin,
};
---

<Layout
  title="Beyond Diagnosis"
  description="Screening schedules, warning signs, and clear guidance grounded in evidence, written for humans. Independent cancer education for people 35+."
  motion={motion}
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden bg-cream">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:py-24">
      <div>
        <interact-element data-interact-key="home-hero-heading" class="block">
          <h1 class="font-display text-4xl font-semibold leading-[1.08] text-navy sm:text-5xl lg:text-[3.4rem]">
            Knowledge changes what happens next.
          </h1>
        </interact-element>
        <interact-element data-interact-key="home-hero-subhead" class="block">
          <p class="mt-5 max-w-lg text-lg leading-relaxed text-navy/75">
            Screening schedules, warning signs, and clear guidance grounded in evidence, written for
            humans.
          </p>
        </interact-element>
        <interact-element data-interact-key="home-hero-ctas" class="block">
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/my-plan"
              class="rounded-full bg-terracotta px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-terracotta-dark"
            >
              Start The Map
            </a>
            <a
              href="#paths"
              class="rounded-full border border-navy/20 bg-white px-6 py-3.5 text-sm font-semibold text-navy transition-colors hover:border-navy/40"
            >
              Explore the paths
            </a>
          </div>
        </interact-element>
      </div>

      <interact-element data-interact-key="home-hero-image" class="block">
        <div>
          <Media
            src={HOMEPAGE_HERO_URL}
            alt="A woman in her 40s reading calmly by a sunlit window"
            ratio="4/3"
            tone="rose"
            loading="eager"
            fetchpriority="high"
            width={900}
            height={675}
          />
        </div>
      </interact-element>
    </div>
  </section>

  <section class="bg-rose/25 py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <interact-element data-interact-key="map-how-it-works" class="block">
        <div>
          <div class="text-center">
            <p class="font-data text-xs uppercase tracking-wide text-terracotta">The Map</p>
            <h2 class="mt-2 font-display text-2xl font-semibold text-navy sm:text-3xl">How it works</h2>
          </div>
          <div class="mx-auto mt-8 grid max-w-4xl gap-5 sm:grid-cols-3">
            <div class="rounded-[12px] bg-white p-6 text-center shadow-[var(--shadow-card)]">
              <span class="mx-auto flex h-9 w-9 items-center justify-center rounded-full bg-terracotta font-data text-sm font-semibold text-white">
                1
              </span>
              <h3 class="mt-3 font-display text-lg font-semibold text-navy">Answer a few honest questions</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-navy/70">
                Age, history, habits. About 60 seconds, no account needed.
              </p>
            </div>
            <div class="rounded-[12px] bg-white p-6 text-center shadow-[var(--shadow-card)]">
              <span class="mx-auto flex h-9 w-9 items-center justify-center rounded-full bg-terracotta font-data text-sm font-semibold text-white">
                2
              </span>
              <h3 class="mt-3 font-display text-lg font-semibold text-navy">Get your personalized timeline</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-navy/70">
                Screenings tailored to you — not a generic checklist.
              </p>
            </div>
            <div class="rounded-[12px] bg-white p-6 text-center shadow-[var(--shadow-card)]">
              <span class="mx-auto flex h-9 w-9 items-center justify-center rounded-full bg-terracotta font-data text-sm font-semibold text-white">
                3
              </span>
              <h3 class="mt-3 font-display text-lg font-semibold text-navy">Bring it to your next appointment</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-navy/70">Print it, or send a copy to your inbox.</p>
            </div>
          </div>
          <div class="mt-8 text-center">
            <a
              href="/my-plan"
              class="inline-flex items-center gap-2 rounded-full bg-terracotta px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-terracotta-dark"
            >
              Start The Map
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
        </div>
      </interact-element>
    </div>
  </section>

  <section id="paths" class="scroll-mt-20 bg-white py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="max-w-xl">
        <h2 class="font-display text-2xl font-semibold text-navy sm:text-3xl">Where do you want to start?</h2>
        <p class="mt-2 text-navy/70">Pick the door that matches how you're feeling right now.</p>
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          PATHS.map((p, i) => (
            <Reveal interactKey={cardKeys[i]}>
              <PathCard href={p.href} title={p.subbrand} description={p.plain} icon={p.icon} />
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-navy py-14 text-cream sm:py-16">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid gap-8 sm:grid-cols-3">
        <Reveal interactKey={statKeys[0]} class="text-center sm:text-left">
          <p class="font-display text-4xl font-semibold text-rose">
            <span data-count-target={warningSigns.length}>0</span>+
          </p>
          <p class="mt-1 text-sm text-cream/70">Warning signs mapped to what they could mean</p>
        </Reveal>
        <Reveal interactKey={statKeys[1]} class="text-center sm:text-left">
          <p class="font-display text-4xl font-semibold text-rose">
            <span data-count-target={accessGuides.length}>0</span>+
          </p>
          <p class="mt-1 text-sm text-cream/70">Access guides with the exact script to use</p>
        </Reveal>
        <Reveal interactKey={statKeys[2]} class="text-center sm:text-left">
          <p class="font-display text-4xl font-semibold text-rose">
            <span data-count-target={cancerTypes.length}>0</span>+
          </p>
          <p class="mt-1 text-sm text-cream/70">Cancer types covered, and growing every month</p>
        </Reveal>
      </div>
    </div>
  </section>

  {
    latestArticles.length > 0 && (
      <section class="bg-cream py-14 sm:py-20">
        <div class="mx-auto max-w-6xl px-5 sm:px-8">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="font-display text-2xl font-semibold text-navy sm:text-3xl">From the library</h2>
            <a href="/library" class="text-sm font-semibold text-terracotta hover:underline">
              See all articles &rarr;
            </a>
          </div>
          <div class="mt-8 grid gap-5 sm:grid-cols-3">
            {latestArticles.map((article, i) => (
              <Reveal interactKey={articleKeys[i]}>
                <ArticleCard article={article} />
              </Reveal>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-rose py-14 sm:py-16">
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <h2 class="font-display text-2xl font-semibold text-navy sm:text-3xl">One email a week. No fear, no fluff.</h2>
      <p class="mt-2 text-navy/70">Straight guidance for people 35+, delivered on a schedule you can trust.</p>
      <div class="mt-6">
        <NewsletterForm variant="inline" />
      </div>
    </div>
  </section>
</Layout>
