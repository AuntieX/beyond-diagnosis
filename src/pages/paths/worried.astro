---
import Layout from "../../layouts/Layout.astro";
import WarningSignCard from "../../components/WarningSignCard.astro";
import Reveal from "../../components/Reveal.astro";
import { getWarningSigns, distinctCancerTypes, primaryCancerLabel } from "../../lib/content";
import { buildConfig, fadeUpGroup, fadeUpReveal, fadeInReveal } from "../../lib/motion";
import { PATHS } from "../../lib/paths";

const meta = PATHS.find((p) => p.key === "worried")!;

const allSigns = await getWarningSigns();
const cancerTypes = distinctCancerTypes(allSigns);
const activeType = Astro.url.searchParams.get("type") || "";
const signs = activeType ? allSigns.filter((s) => primaryCancerLabel(s.cancer_type) === activeType) : allSigns;

const keys = signs.map((_, i) => `worried-sign-${i}`);
const motion = buildConfig([
  fadeUpReveal("worried-heading", 0),
  fadeUpReveal("worried-subhead", 100),
  fadeInReveal("worried-pills", 200),
  ...fadeUpGroup(keys),
]);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "I'm worried about symptoms — Beyond Diagnosis",
  url: new URL("/paths/worried", Astro.site ?? Astro.url.origin),
};
---

<Layout
  title="I'm worried about symptoms"
  description="Something feels off. Filter warning signs by cancer type and get direct answers on what to do next."
  motion={motion}
  jsonLd={jsonLd}
  canonicalPath="/paths/worried"
>
  <section class="bg-white py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <interact-element data-interact-key="worried-heading" class="block">
        <div>
          <p class="font-data text-xs uppercase tracking-wide text-terracotta">{meta.subbrand}</p>
          <h1 class="mt-2 font-display text-3xl font-semibold text-navy sm:text-4xl">{meta.tagline}</h1>
        </div>
      </interact-element>
      <interact-element data-interact-key="worried-subhead" class="block">
        <p class="mt-3 max-w-2xl text-navy/70">
          Listen. If something in your body has been nagging at you, you deserve a straight answer —
          not a scroll through forums that end in panic. Filter by cancer type below, or browse
          everything.
        </p>
      </interact-element>

      <interact-element data-interact-key="worried-pills" class="block">
        <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter by cancer type">
          <a
            href="/paths/worried"
            class:list={[
              "rounded-full px-4 py-2 text-sm font-semibold transition-colors",
              !activeType ? "bg-navy text-cream" : "bg-rose text-navy hover:bg-rose/70",
            ]}
          >
            All
          </a>
          {
            cancerTypes.map((type) => (
              <a
                href={`/paths/worried?type=${encodeURIComponent(type)}`}
                class:list={[
                  "rounded-full px-4 py-2 text-sm font-semibold transition-colors",
                  activeType === type ? "bg-navy text-cream" : "bg-rose text-navy hover:bg-rose/70",
                ]}
              >
                {type}
              </a>
            ))
          }
        </div>
      </interact-element>

      <h2 class="sr-only">Warning signs{activeType ? ` — ${activeType}` : ""}</h2>
      {
        signs.length === 0 ? (
          <p class="mt-10 text-navy/70">No warning signs match that filter yet — check back soon as we expand the library.</p>
        ) : (
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {signs.map((sign, i) =>
              i === 0 ? (
                // Card 0 is the likely LCP element on this page (no hero image
                // above it) — skip the entrance animation so its image paints
                // immediately instead of waiting behind @wix/interact's FOUC guard.
                <WarningSignCard sign={sign} eager />
              ) : (
                <Reveal interactKey={keys[i]}>
                  <WarningSignCard sign={sign} />
                </Reveal>
              )
            )}
          </div>
        )
      }
    </div>
  </section>
</Layout>
