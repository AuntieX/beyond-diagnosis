---
import Layout from "../../layouts/Layout.astro";
import EntryCard from "../../components/EntryCard.astro";
import Reveal from "../../components/Reveal.astro";
import { getLifeStageEntries, distinctCancerTags, cancerTagsList, type LifeStageEntry } from "../../lib/content";
import { buildConfig, fadeUpGroup } from "../../lib/motion";
import { PATHS } from "../../lib/paths";

const meta = PATHS.find((p) => p.key === "treatment")!;

interface CombinedEntry extends LifeStageEntry {
  _basePath: string;
}

const [therapies, trials] = await Promise.all([getLifeStageEntries("Therapies"), getLifeStageEntries("Trials")]);
const combined: CombinedEntry[] = [
  ...therapies.map((e) => ({ ...e, _basePath: "/therapies" })),
  ...trials.map((e) => ({ ...e, _basePath: "/trials" })),
];

const cancerTypes = distinctCancerTags(combined);
const activeType = Astro.url.searchParams.get("type") || "";
const entries = activeType ? combined.filter((e) => cancerTagsList(e.cancer_tags).includes(activeType)) : combined;

const keys = entries.map((_, i) => `treatment-entry-${i}`);
const motion = buildConfig(fadeUpGroup(keys));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Second Opinion — Beyond Diagnosis",
  url: new URL("/paths/treatment", Astro.site ?? Astro.url.origin),
};
---

<Layout
  title="I'm in treatment"
  description="Cold caps, clinical trials, side effects, and the questions to ask — straight talk for the part no one prepares you for."
  motion={motion}
  jsonLd={jsonLd}
  canonicalPath="/paths/treatment"
>
  <section class="bg-white py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <p class="font-data text-xs uppercase tracking-wide text-terracotta">{meta.subbrand}</p>
      <h1 class="mt-2 font-display text-3xl font-semibold text-navy sm:text-4xl">{meta.tagline}</h1>
      <p class="mt-3 max-w-2xl text-navy/70">
        Cold caps, clinical trials, side effects, and the questions to ask — straight talk for the part
        no one prepares you for.
      </p>

      {
        cancerTypes.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter by cancer type">
            <a
              href="/paths/treatment"
              class:list={[
                "rounded-full px-4 py-2 text-sm font-semibold transition-colors",
                !activeType ? "bg-navy text-cream" : "bg-rose text-navy hover:bg-rose/70",
              ]}
            >
              All
            </a>
            {cancerTypes.map((type) => (
              <a
                href={`/paths/treatment?type=${encodeURIComponent(type)}`}
                class:list={[
                  "rounded-full px-4 py-2 text-sm font-semibold transition-colors",
                  activeType === type ? "bg-navy text-cream" : "bg-rose text-navy hover:bg-rose/70",
                ]}
              >
                {type}
              </a>
            ))}
          </div>
        )
      }

      <h2 class="sr-only">Treatment guides{activeType ? ` — ${activeType}` : ""}</h2>
      {
        entries.length === 0 ? (
          <p class="mt-10 text-navy/70">No guides match that filter yet — check back soon as we expand this section.</p>
        ) : (
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {entries.map((entry, i) => (
              <Reveal interactKey={keys[i]}>
                <EntryCard entry={entry} basePath={entry._basePath} tone="terracotta" eager={i === 0} />
              </Reveal>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Layout>
