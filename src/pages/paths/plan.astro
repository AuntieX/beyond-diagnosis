---
import Layout from "../../layouts/Layout.astro";
import AccessGuideCard from "../../components/AccessGuideCard.astro";
import Reveal from "../../components/Reveal.astro";
import { getAccessGuides, primaryCancerLabel } from "../../lib/content";
import { buildConfig, fadeUpGroup } from "../../lib/motion";
import { PATHS } from "../../lib/paths";

const meta = PATHS.find((p) => p.key === "plan")!;

const allGuides = await getAccessGuides();
const cancerTypes = Array.from(new Set(allGuides.map((g) => primaryCancerLabel(g.cancer_type))))
  .filter((t) => t !== "General")
  .sort();
const activeType = Astro.url.searchParams.get("type") || "";
const guides = activeType ? allGuides.filter((g) => primaryCancerLabel(g.cancer_type) === activeType) : allGuides;

const keys = guides.map((_, i) => `plan-guide-${i}`);
const motion = buildConfig(fadeUpGroup(keys));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "I need a screening plan — Beyond Diagnosis",
  url: new URL("/paths/plan", Astro.site ?? Astro.url.origin),
};
---

<Layout
  title="I need a screening plan"
  description="Find out exactly which screenings you're due for, and the exact script to get them covered."
  motion={motion}
  jsonLd={jsonLd}
  canonicalPath="/paths/plan"
>
  <section class="bg-white py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <p class="font-data text-xs uppercase tracking-wide text-sage-dark">{meta.subbrand}</p>
      <h1 class="mt-2 font-display text-3xl font-semibold text-navy sm:text-4xl">{meta.tagline}</h1>
      <p class="mt-3 max-w-2xl text-navy/70">
        Getting screened shouldn't require a fight — but sometimes it does. These guides give you
        the exact steps, the exact ask, and what to do if insurance says no.
      </p>

      <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter by cancer type">
        <a
          href="/paths/plan"
          class:list={[
            "rounded-full px-4 py-2 text-sm font-semibold transition-colors",
            !activeType ? "bg-navy text-cream" : "bg-rose text-navy hover:bg-rose/70",
          ]}
        >
          All
        </a>
        {
          cancerTypes.map((type) => (
            <a
              href={`/paths/plan?type=${encodeURIComponent(type)}`}
              class:list={[
                "rounded-full px-4 py-2 text-sm font-semibold transition-colors",
                activeType === type ? "bg-navy text-cream" : "bg-rose text-navy hover:bg-rose/70",
              ]}
            >
              {type}
            </a>
          ))
        }
      </div>

      <h2 class="sr-only">Access guides{activeType ? ` — ${activeType}` : ""}</h2>
      {
        guides.length === 0 ? (
          <p class="mt-10 text-navy/70">No access guides match that filter yet — check back soon as we expand the library.</p>
        ) : (
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {guides.map((guide, i) => (
              <Reveal interactKey={keys[i]}>
                <AccessGuideCard guide={guide} eager={i === 0} />
              </Reveal>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Layout>
