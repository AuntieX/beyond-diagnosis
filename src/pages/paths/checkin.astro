---
import Layout from "../../layouts/Layout.astro";
import Reveal from "../../components/Reveal.astro";
import PathCard from "../../components/PathCard.astro";
import { getWarningSigns, getAccessGuides, distinctCancerTypes, primaryCancerLabel } from "../../lib/content";
import { buildConfig, fadeUpGroup, fadeUpReveal } from "../../lib/motion";
import { PATHS } from "../../lib/paths";

const meta = PATHS.find((p) => p.key === "checkin")!;

const [signs, guides] = await Promise.all([getWarningSigns(), getAccessGuides()]);
const cancerTypes = distinctCancerTypes(signs);

const snapshot = cancerTypes.map((type) => {
  const sign = signs.find((s) => primaryCancerLabel(s.cancer_type) === type);
  const guide = guides.find((g) => primaryCancerLabel(g.cancer_type) === type);
  return { type, sign, guide };
});

const keys = snapshot.map((_, i) => `checkin-${i}`);
const motion = buildConfig([
  fadeUpReveal("checkin-heading", 0),
  fadeUpReveal("checkin-subhead", 100),
  ...fadeUpGroup(keys),
]);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Five-minute check-in — Beyond Diagnosis",
  url: new URL("/paths/checkin", Astro.site ?? Astro.url.origin),
};
---

<Layout
  title="I just want to check in"
  description="A five-minute snapshot of where you stand on cancer screening and warning signs — no rabbit holes."
  motion={motion}
  jsonLd={jsonLd}
  canonicalPath="/paths/checkin"
>
  <section class="bg-white py-14 sm:py-20">
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <interact-element data-interact-key="checkin-heading" class="block">
        <div>
          <p class="font-data text-xs uppercase tracking-wide text-sage-dark">{meta.subbrand}</p>
          <h1 class="mt-2 font-display text-3xl font-semibold text-navy sm:text-4xl">
            {meta.tagline}
          </h1>
        </div>
      </interact-element>
      <interact-element data-interact-key="checkin-subhead" class="block">
        <p class="mt-3 text-navy/70">
          No rabbit holes, no doom-scrolling. Here's a fast snapshot, by cancer type — one thing to
          watch for, one thing to get scheduled.
        </p>
      </interact-element>
    </div>
  </section>

  <section class="bg-cream py-6 pb-14 sm:pb-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          snapshot.map((row, i) => (
            <Reveal interactKey={keys[i]}>
              <div class="flex h-full flex-col rounded-[12px] bg-white p-6 shadow-[var(--shadow-card)]">
                <span class="font-data text-xs uppercase tracking-wide text-terracotta">{row.type}</span>
                {row.sign && (
                  <>
                    <h2 class="mt-2 font-display text-lg font-semibold text-navy">Watch for: {row.sign.sign_name}</h2>
                    <a
                      href={`/warning-signs/${row.sign.slug}`}
                      class="mt-2 text-sm font-semibold text-terracotta hover:underline"
                    >
                      What it could mean &rarr;
                    </a>
                  </>
                )}
                {row.guide && (
                  <a
                    href={`/access-guides/${row.guide.slug}`}
                    class="mt-4 text-sm font-semibold text-sage-dark hover:underline"
                  >
                    Get screened: {row.guide.title} &rarr;
                  </a>
                )}
              </div>
            </Reveal>
          ))
        }
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        <PathCard
          href="/paths/worried"
          title="Something feels off"
          description="Go deeper on symptoms and what they could mean, by cancer type."
          icon="worried"
        />
        <PathCard
          href="/paths/plan"
          title="Ready to get screened"
          description="Get the exact steps and scripts to make it happen, even if insurance pushes back."
          icon="plan"
        />
      </div>
    </div>
  </section>
</Layout>
