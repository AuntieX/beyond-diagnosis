---
import Layout from "../../layouts/Layout.astro";
import EntryCard from "../../components/EntryCard.astro";
import Reveal from "../../components/Reveal.astro";
import { getLifeStageEntries, distinctCancerTags, cancerTagsList } from "../../lib/content";
import { buildConfig, fadeUpGroup, fadeUpReveal, fadeInReveal } from "../../lib/motion";
import { PATHS } from "../../lib/paths";

const meta = PATHS.find((p) => p.key === "rebuilding")!;

const allEntries = await getLifeStageEntries("Recovery");
const cancerTypes = distinctCancerTags(allEntries);
const activeType = Astro.url.searchParams.get("type") || "";
const entries = activeType ? allEntries.filter((e) => cancerTagsList(e.cancer_tags).includes(activeType)) : allEntries;

const keys = entries.map((_, i) => `rebuilding-entry-${i}`);
const motion = buildConfig([
  fadeUpReveal("rebuilding-heading", 0),
  fadeUpReveal("rebuilding-subhead", 100),
  fadeInReveal("rebuilding-pills", 200),
  ...fadeUpGroup(keys),
]);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "The Rebuild — Beyond Diagnosis",
  url: new URL("/paths/rebuilding", Astro.site ?? Astro.url.origin),
};
---

<Layout
  title="I'm rebuilding"
  description="Rebuilding strength, energy, and steadiness after treatment — gently, and at your pace."
  motion={motion}
  jsonLd={jsonLd}
  canonicalPath="/paths/rebuilding"
>
  <section class="bg-white py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <interact-element data-interact-key="rebuilding-heading" class="block">
        <div>
          <p class="font-data text-xs uppercase tracking-wide text-terracotta">{meta.subbrand}</p>
          <h1 class="mt-2 font-display text-3xl font-semibold text-navy sm:text-4xl">{meta.tagline}</h1>
        </div>
      </interact-element>
      <interact-element data-interact-key="rebuilding-subhead" class="block">
        <p class="mt-3 max-w-2xl text-navy/70">
          Rebuilding strength, energy, and steadiness after treatment — gently, and at your pace.
        </p>
      </interact-element>

      {
        cancerTypes.length > 0 && (
          <interact-element data-interact-key="rebuilding-pills" class="block">
            <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter by cancer type">
              <a
                href="/paths/rebuilding"
                class:list={[
                  "rounded-full px-4 py-2 text-sm font-semibold transition-colors",
                  !activeType ? "bg-navy text-cream" : "bg-rose text-navy hover:bg-rose/70",
                ]}
              >
                All
              </a>
              {cancerTypes.map((type) => (
                <a
                  href={`/paths/rebuilding?type=${encodeURIComponent(type)}`}
                  class:list={[
                    "rounded-full px-4 py-2 text-sm font-semibold transition-colors",
                    activeType === type ? "bg-navy text-cream" : "bg-rose text-navy hover:bg-rose/70",
                  ]}
                >
                  {type}
                </a>
              ))}
            </div>
          </interact-element>
        )
      }

      <h2 class="sr-only">Recovery guides{activeType ? ` — ${activeType}` : ""}</h2>
      {
        entries.length === 0 ? (
          <p class="mt-10 text-navy/70">No guides match that filter yet — check back soon as we expand this section.</p>
        ) : (
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {entries.map((entry, i) =>
              i === 0 ? (
                <EntryCard entry={entry} basePath="/recovery" tone="rose" eager />
              ) : (
                <Reveal interactKey={keys[i]}>
                  <EntryCard entry={entry} basePath="/recovery" tone="rose" />
                </Reveal>
              )
            )}
          </div>
        )
      }
    </div>
  </section>
</Layout>
