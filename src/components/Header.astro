---
import { PATHS } from "../lib/paths";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(href + "/");
}

const isOnAPath = PATHS.some((p) => isActive(p.href));
---

<header class="border-b border-navy/10 bg-cream/95 backdrop-blur-sm sticky top-0 z-40">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
    <a href="/" class="font-display text-lg font-semibold tracking-tight text-navy sm:text-xl">
      Beyond Diagnosis
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-6 md:flex">
      <details class="nav-dropdown relative">
        <summary
          class:list={[
            "flex cursor-pointer list-none items-center gap-1 text-sm font-medium transition-colors hover:text-terracotta [&::-webkit-details-marker]:hidden",
            isOnAPath ? "text-terracotta" : "text-navy/80",
          ]}
        >
          Paths
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="absolute left-1/2 top-full z-50 mt-3 w-80 -translate-x-1/2 rounded-[12px] border border-navy/10 bg-white p-2 shadow-[var(--shadow-card-hover)]">
          {
            PATHS.map((p) => (
              <a href={p.href} class="block rounded-md px-3 py-2 transition-colors hover:bg-rose">
                <span class="block text-sm font-semibold text-navy">{p.subbrand}</span>
                <span class="block text-xs text-navy/70">{p.plain}</span>
              </a>
            ))
          }
        </div>
      </details>
      <a
        href="/my-plan"
        class:list={[
          "text-sm font-semibold transition-colors hover:text-terracotta",
          isActive("/my-plan") ? "text-terracotta" : "text-navy",
        ]}
      >
        The Map
      </a>
      <a
        href="/library"
        class:list={[
          "text-sm font-medium transition-colors hover:text-terracotta",
          isActive("/library") ? "text-terracotta" : "text-navy/80",
        ]}
      >
        Library
      </a>
    </nav>

    <a
      href="/newsletter"
      class="hidden rounded-full bg-navy px-4 py-2 text-sm font-semibold text-cream transition-colors hover:bg-terracotta sm:inline-block"
    >
      Get the newsletter
    </a>

    <details class="md:hidden">
      <summary
        class="list-none rounded-md border border-navy/20 px-3 py-1.5 text-sm font-medium text-navy [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        Menu
      </summary>
      <nav
        aria-label="Primary mobile"
        class="absolute left-0 right-0 flex flex-col gap-1 border-b border-navy/10 bg-cream px-5 py-4 shadow-lg"
      >
        <p class="mt-1 px-2 font-data text-xs uppercase tracking-wide text-navy/70">Paths</p>
        {
          PATHS.map((p) => (
            <a href={p.href} class="rounded-md px-2 py-2 hover:bg-rose">
              <span class="block text-sm font-semibold text-navy">{p.subbrand}</span>
              <span class="block text-xs text-navy/70">{p.plain}</span>
            </a>
          ))
        }
        <a href="/my-plan" class="mt-2 rounded-md px-2 py-2 text-sm font-semibold text-terracotta hover:bg-rose">
          The Map
        </a>
        <a href="/library" class="rounded-md px-2 py-2 text-sm font-medium text-navy hover:bg-rose">
          Library
        </a>
        <a href="/newsletter" class="rounded-md px-2 py-2 text-sm font-semibold text-terracotta hover:bg-rose">
          Get the newsletter
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Native <details> dropdowns don't close on outside click or link selection —
  // wire that up without pulling in a JS framework for a single nav widget.
  document.querySelectorAll<HTMLDetailsElement>(".nav-dropdown").forEach((dropdown) => {
    dropdown.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) dropdown.open = false;
    });
    document.addEventListener("click", (e) => {
      if (!dropdown.open) return;
      if (!dropdown.contains(e.target as Node)) dropdown.open = false;
    });
  });
</script>
