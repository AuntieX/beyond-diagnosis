---
// Shared card for the four life-stage collections (Therapies, Trials, Environment,
// Recovery) — same visual language as WarningSignCard / AccessGuideCard.
import Media from "./Media.astro";
import type { LifeStageEntry } from "../lib/content";

interface Props {
  entry: LifeStageEntry;
  basePath: string;
  tone?: "sage" | "terracotta" | "rose";
  eager?: boolean;
}
const { entry, basePath, tone = "sage", eager = false } = Astro.props;
---

<a
  href={`${basePath}/${entry.slug}`}
  class="group block overflow-hidden rounded-[12px] bg-white shadow-[var(--shadow-card)] transition-shadow hover:shadow-[var(--shadow-card-hover)]"
>
  <Media
    src={entry.heroImage}
    alt={entry.title}
    ratio="4/3"
    tone={tone}
    width={600}
    height={450}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />
  <div class="p-5">
    <span class="font-data text-xs uppercase tracking-wide text-sage-dark">{entry.pillar}</span>
    <h3 class="mt-1.5 font-display text-lg font-semibold leading-snug text-navy group-hover:text-terracotta">
      {entry.title}
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-navy/70 line-clamp-2">
      {entry.intro}
    </p>
  </div>
</a>
